{
	"name": "mrdemonwolf-wp-plugin",
	"private": true,
	"workspaces": [
		"apps/docs",
		"apps/plugin"
	],
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "turbo typecheck",
		"test": "turbo test",
		"clean": "turbo clean",
		"docs:dev": "bun run --filter @mrdemonwolf/docs dev",
		"docs:build": "bun run --filter @mrdemonwolf/docs build",
		"plugin:test": "cd apps/plugin && composer test",
		"plugin:lint": "cd apps/plugin && composer lint",
		"plugin:zip": "apps/plugin/bin/build-zip.sh",
		"plugin:css": "bun run --filter @mrdemonwolf/plugin build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@next/eslint-plugin-next": "^16.2.10",
		"bun-types": "^1.3.14",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-unused-imports": "^4.4.1",
		"prettier": "^3.9.5",
		"turbo": "^2.10.4",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.63.0"
	},
	"packageManager": "bun@1.3.10",
	"engines": {
		"node": ">=20"
	}
}
